# --- Brevo transactional email ---
# API key from Brevo: SMTP & API > API Keys
BREVO_API_KEY=your-brevo-api-key

# Sender address/domain MUST be verified in Brevo (Senders, Domains & Dedicated IPs)
CONTACT_SENDER_EMAIL=no-reply@yourdomain.com
CONTACT_SENDER_NAME=Mario Alessandro Sfienti

# Where contact-form notifications are delivered
CONTACT_TO_EMAIL=mario@sfienti.it
CONTACT_TO_NAME=Mario Alessandro Sfienti
